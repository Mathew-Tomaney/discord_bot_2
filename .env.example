# ---- Required ----
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# ---- Optional ----
# Register slash commands to ONE server only (instant updates). Leave blank for global (can take up to an hour to appear).
GUILD_ID=

# Register slash commands automatically on every boot (true/false). Default true.
AUTO_DEPLOY_COMMANDS=true

# Default music volume, 0-200 (percent). Default 50.
DEFAULT_VOLUME=50

# Leave the voice channel after this many seconds with nothing playing. Default 300.
IDLE_TIMEOUT_SECONDS=300

# Max tracks pulled from one YouTube playlist. Default 100.
MAX_PLAYLIST_ITEMS=100

# Comma-separated folders scanned for soundboard clips. Default: sounds,sounds-builtin
SOUND_DIRS=sounds,sounds-builtin

# Paths to the binaries if they are not on PATH.
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg

# If YouTube says "Sign in to confirm you're not a bot" (common on cloud servers),
# export cookies from a logged-in browser (Netscape format) and point to the file here.
# YTDLP_COOKIES=/app/cookies.txt

# Extra arguments passed to every yt-dlp call (space separated), e.g. a proxy:
# YTDLP_ARGS=--proxy socks5://127.0.0.1:1080

# Run "yt-dlp -U" on container start (Docker only). Default true. YouTube changes often; this keeps playback working.
YTDLP_AUTO_UPDATE=true
